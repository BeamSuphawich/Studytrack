# Copy this file to .env and set real passwords. .env is in .gitignore: never commit it.

# MySQL root password (used by the db container and phpMyAdmin root login)
MYSQL_ROOT_PASSWORD=change-me-root

# Application database and user (the backend logs in with these)
DB_NAME=studyplanner
DB_USER=studyplanner
DB_PASSWORD=change-me-app

# true = every new account gets sample courses, tasks and grades
APP_SAMPLE_DATA=true
